    } else out.push('No dimension is in the low range this week.');
    var rest = [];
    if(ok.length) rest.push(cap(list(ok))+(ok.length>1?' are':' is')+' high');
    if(mid.length) rest.push(list(mid)+(mid.length>1?' are':' is')+' moderate');
    if(rest.length) out.push(cap(rest.join('; '))+'.');
    var needs = DOMAINS.filter(function(d){return d.kind==='need';});
    var unassessed = needs.filter(function(d){return val(c,d.f)==null;});
    var hot = needs.filter(function(d){var v=val(c,d.f);return v!=null && v>=6;});
    if(unassessed.length===3) out.push('Need frustration has not been assessed, so this check-in cannot yet separate needs that are underfed from needs that are being actively undermined.');
    else if(hot.length) out.push('Active frustration is high for '+hot.map(function(d){return d.name.toLowerCase()+' ('+val(c,d.f)+'/10)';}).join(' and ')+'. That points to something undermining the need, not only too few chances to meet it.');
