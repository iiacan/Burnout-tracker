    list.forEach(function(c){ var v=SDD.val(c,s.key); if(v==null){pen=false;return;} var x=X(c.date),y=Y(v); path+=(pen?'L':'M')+x.toFixed(1)+' '+y.toFixed(1)+' '; pen=true; last={x:x,y:y,v:v};
      out+='<circle cx="'+x.toFixed(1)+'" cy="'+y.toFixed(1)+'" r="2.2" fill="'+s.color+'"/>'; });
