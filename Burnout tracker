    });
    var heavy = out.affected.filter(function(id){return out.domains[id].flags.some(function(x){return x.weight>=2;});});
    var pers = out.affected.filter(function(id){return out.domains[id].flags.some(function(x){return x.type==='persistent-low';});});
    var persState = pers.some(function(id){return dom(id).kind==='state';});
    if(pers.length>=3 || (pers.length>=2 && persState)) out.level='significant';
    else if(heavy.length>=1 || out.affected.length>=2) out.level='attention';
