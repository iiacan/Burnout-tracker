    pools.forEach(function(pool){ pool.forEach(function(s){ if(out.actions.length<3 && !seen[s.text]){ out.actions.push(s); seen[s.text]=1; } }); });
    return out;
  }

  function factorLabels(c,d){ var fs=(c.factors&&c.factors[d.id])||[]; return fs.map(function(k){return d.factors[k]||k;}); }

  function summary(checkins, interventions, profile){
    var cs = sortC(checkins||[]), n = cs.length; if(!n) return [];
    var c = cs[n-1], prev = n>1 ? cs[n-2] : null, out = [];
    var low = DOMAINS.filter(function(d){var v=val(c,d.s);return v!=null && v<=4;}).sort(function(a,b){return val(c,a.s)-val(c,b.s);});
    var ok = DOMAINS.filter(function(d){var v=val(c,d.s);return v!=null && v>=7;});
    var mid = DOMAINS.filter(function(d){var v=val(c,d.s);return v!=null && v>=5 && v<=6;});
    function list(ds){ return ds.map(function(d){return label(d).toLowerCase()+' ('+val(c,d.s)+'/10)';}).join(', ').replace(/, ([^,]*)$/,' and $1'); }
    if(low.length){
      var s = cap(list(low))+(low.length>1?' are':' is')+' low this week.';
      low.forEach(function(d){ var fl = factorLabels(c,d); if(fl.length) s += ' For '+d.name.toLowerCase()+' you named: '+fl.join(', ').toLowerCase()+'.'; });
