  }
  return {DOMAINS:DOMAINS,KEYS:KEYS,KEYNAMES:KEYNAMES,AREAS:AREAS,WORK_AREAS:WORK_AREAS,SUG:SUG,LEVELS:LEVELS,band:band,mean:mean,sortC:sortC,val:val,series:series,dom:dom,label:label,baseline:baseline,analyse:analyse,priorities:priorities,summary:summary,factorLabels:factorLabels,associations:associations,monthly:monthly,factorCounts:factorCounts,tagCounts:tagCounts,areaMap:areaMap,effect:effect,csv:csv};
})();
