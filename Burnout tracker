    if(!iv.started) return {started:false};
    var before = cs.filter(function(c){return c.date<=iv.started;}), after = cs.filter(function(c){return c.date>iv.started;});
    var start = before.length ? val(before[before.length-1],d.s) : null;
    var av = after.map(function(c){return val(c,d.s);}).filter(function(v){return v!=null;});
    return {started:true, label:label(d), start:start, after:av.slice(0,8), change:(start!=null && av.length)? mean(av.slice(-3))-start : null};
  }
  function csv(checkins){
    var cs = sortC(checkins||[]);
    function q(s){ s = String(s==null?'':s); return /[",\n]/.test(s) ? '"'+s.replace(/"/g,'""')+'"' : s; }
    var head = ['date'].concat(KEYS).concat(DOMAINS.map(function(d){return d.id+'_factors';})).concat(DOMAINS.map(function(d){return d.id+'_notes';})).concat(DOMAINS.map(function(d){return d.id+'_reflection';})).concat(['restored']);
