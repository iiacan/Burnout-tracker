    out+= d.kind==='need' ? '<circle cx="'+p[0].toFixed(1)+'" cy="'+p[1].toFixed(1)+'" r="4.5" fill="'+col+'"/>' : '<rect x="'+(p[0]-4).toFixed(1)+'" y="'+(p[1]-4).toFixed(1)+'" width="8" height="8" fill="var(--bg)" stroke="'+col+'" stroke-width="1.6"/>';
    var anchor = Math.abs(l[0]-cx)<8?'middle':(l[0]>cx?'start':'end');
