  function priorities(checkins, interventions){
    var cs = sortC(checkins||[]), n = cs.length, out = {focus:[], actions:[], lowRecovery:false};
    if(!n) return out;
    var c = cs[n-1], rec = val(c,'recovery');
    out.lowRecovery = rec!=null && rec<=4;
    var scored = DOMAINS.map(function(d){
      var sat = val(c,d.s); if(sat==null) return {d:d,p:0};
