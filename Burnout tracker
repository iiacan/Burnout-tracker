  D.forEach(function(d,i){ var p=pt(i,10); out+='<line x1="'+cx+'" y1="'+cy+'" x2="'+p[0].toFixed(1)+'" y2="'+p[1].toFixed(1)+'" stroke="var(--line)" stroke-width=".7"/>'; });
