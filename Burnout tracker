<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="SDT Dashboard">
<meta name="robots" content="noindex">
<title>Self-Determination Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" defer></script>
<style>
/* Layout idea: one narrow editorial column, hairline rules between sections, no card grid.
   The three needs carry colour; energy and recovery stay neutral and use a different bar form. */
:root{
  --bg:#f3eee4; --surface:#faf7f0; --ink:#25282a; --muted:#6a6860; --line:#d9d1c1; --track:#e6dfd1;
  --aut:#2f4a6d; --comp:#b25538; --rel:#567659; --state:#3b3e41;
  --watch:#9a7412; --attn:#b9571f; --sig:#962c2c; --ok:#4a674d;
  --display:"Newsreader","Iowan Old Style",Georgia,serif;
  --body:"IBM Plex Sans","Helvetica Neue",Arial,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#1b1c1b; --surface:#242523; --ink:#ebe5d9; --muted:#a29d92; --line:#3b3a35; --track:#30302c;
    --aut:#8fb0dc; --comp:#e08b6c; --rel:#9bbf9d; --state:#d6d0c4;
    --watch:#d9b24a; --attn:#e88a52; --sig:#e87878; --ok:#9bbf9d; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#1b1c1b; --surface:#242523; --ink:#ebe5d9; --muted:#a29d92; --line:#3b3a35; --track:#30302c;
  --aut:#8fb0dc; --comp:#e08b6c; --rel:#9bbf9d; --state:#d6d0c4;
  --watch:#d9b24a; --attn:#e88a52; --sig:#e87878; --ok:#9bbf9d; color-scheme:dark;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 var(--body)}
.wrap{max-width:680px;margin:0 auto;padding:0 20px 96px}
.mast{padding:36px 0 18px}
.eyebrow{font:500 11px/1.4 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin:0 0 10px}
h1{font:400 38px/1.02 var(--display);letter-spacing:-.01em;margin:0;text-wrap:balance}
h1 em{font-style:italic}
.sub{font:italic 400 18px/1.35 var(--display);color:var(--muted);margin:10px 0 0;max-width:30em;text-wrap:balance}
nav.tabs{position:sticky;top:0;z-index:5;background:var(--bg);border-top:1px solid var(--ink);border-bottom:1px solid var(--line);display:flex;gap:4px;overflow-x:auto;margin:0 -20px;padding:0 16px;scrollbar-width:none}
nav.tabs::-webkit-scrollbar{display:none}
nav.tabs a{flex:none;padding:12px 8px 11px;font:500 13px/1 var(--body);color:var(--muted);text-decoration:none;border-bottom:2px solid transparent;white-space:nowrap}
nav.tabs a[aria-current="page"]{color:var(--ink);border-bottom-color:var(--ink)}
a{color:inherit}
:focus-visible{outline:2px solid var(--aut);outline-offset:2px}
section{padding:26px 0;border-bottom:1px solid var(--line)}
section:last-child{border-bottom:0}
h2{font:400 25px/1.15 var(--display);margin:0 0 4px;text-wrap:balance}
h3{font:600 15px/1.3 var(--body);margin:0}
h4{font:600 13px/1.3 var(--body);margin:18px 0 6px}
p{margin:8px 0}
.lede{color:var(--muted);font-size:14px;margin:2px 0 16px;max-width:60ch}
.small{font-size:13px;color:var(--muted)}
.num{font:500 15px/1 var(--mono);font-variant-numeric:tabular-nums}
.stack{display:flex;flex-direction:column;gap:18px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.spread{display:flex;justify-content:space-between;gap:12px;align-items:baseline;flex-wrap:wrap}

/* status */
.status{display:flex;gap:14px;align-items:flex-start;padding:16px;background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--lc,var(--muted))}
.status[data-l="stable"]{--lc:var(--ok)} .status[data-l="watch"]{--lc:var(--watch)}
.status[data-l="attention"]{--lc:var(--attn)} .status[data-l="significant"]{--lc:var(--sig)}
.pips{display:flex;gap:3px;margin-top:5px;flex:none}
.pips i{width:8px;height:8px;border-radius:50%;border:1.5px solid var(--lc,var(--muted))}
.pips i.on{background:var(--lc)}
.status strong{font:600 15px/1.3 var(--body)}
.status ul{margin:6px 0 0;padding-left:18px;font-size:14px}
.status li{margin:3px 0}

/* measures */
.need{--c:var(--state)}
.need[data-d="aut"]{--c:var(--aut)} .need[data-d="comp"]{--c:var(--comp)} .need[data-d="rel"]{--c:var(--rel)}
.need h3{color:var(--c)}
.meas{display:grid;grid-template-columns:1fr 34px;gap:10px;align-items:center;margin-top:8px}
.bar{height:12px;background:var(--track);border-radius:2px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--c);border-radius:2px;transition:width .5s ease}
.bar.fr i{background:repeating-linear-gradient(135deg,var(--c) 0 3px,transparent 3px 6px)}
.bar.st{height:6px;border-radius:0;background:transparent;border-bottom:1px solid var(--muted)}
.bar.st i{border-radius:0;background:var(--state)}
.meas .num{text-align:right}
.meta{display:flex;justify-content:space-between;gap:10px;font-size:12.5px;color:var(--muted);margin-top:5px;flex-wrap:wrap}
.ctx{font-size:13px;color:var(--muted);margin:6px 0 0}
.delta.up{color:var(--ok)} .delta.down{color:var(--attn)}
.na{font-size:13px;color:var(--muted);font-style:italic}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:22px}
@media (max-width:520px){.grid2{grid-template-columns:1fr}h1{font-size:31px}.sub{font-size:16px}}
svg{max-width:100%;height:auto;display:block}
svg text{font:11px var(--body);fill:var(--muted)}
svg .v{font:500 11px var(--mono);fill:var(--ink)}
.chart{overflow-x:auto}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12.5px;color:var(--muted);margin-top:6px}
.legend i{display:inline-block;width:16px;height:0;border-top:2px solid var(--c);vertical-align:middle;margin-right:5px}
.legend i.dash{border-top-style:dashed}

/* controls */
button,.btn{font:500 14px/1 var(--body);padding:11px 16px;border:1px solid var(--ink);background:transparent;color:var(--ink);border-radius:2px;cursor:pointer;text-decoration:none;display:inline-block}
button.primary,.btn.primary{background:var(--ink);color:var(--bg)}
button.quiet{border-color:var(--line);color:var(--muted);padding:8px 12px;font-size:13px}
button.danger{border-color:var(--sig);color:var(--sig)}
button:disabled{opacity:.45;cursor:default}
label{font-size:13px;font-weight:500;display:block;margin:12px 0 5px}
input[type=text],input[type=date],input[type=number],select,textarea{width:100%;font:15px/1.4 var(--body);color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:2px;padding:10px 11px}
textarea{min-height:76px;resize:vertical}
input[type=range]{width:100%;accent-color:var(--c);height:30px;margin:0}
.slider{display:grid;grid-template-columns:1fr 44px;gap:12px;align-items:center}
.slider output{font:500 22px/1 var(--mono);text-align:right;color:var(--c)}
.q{font-size:14px;margin:14px 0 2px}
.scale{display:flex;justify-content:space-between;font-size:11.5px;color:var(--muted)}
.check{display:flex;gap:8px;align-items:center;font-size:13px;font-weight:400;margin:8px 0 0;color:var(--muted)}
.check input{width:18px;height:18px;accent-color:var(--ink)}
.chips{display:flex;flex-wrap:wrap;gap:7px}
.chip{font:400 13px/1 var(--body);padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:transparent;color:var(--ink)}
.chip[aria-pressed="true"]{background:var(--c,var(--ink));border-color:var(--c,var(--ink));color:var(--bg)}
details{margin-top:12px}
summary{font-size:13px;font-weight:500;cursor:pointer;color:var(--muted);padding:6px 0}
.tag{display:inline-block;font:500 10.5px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:4px 6px;border:1px solid currentColor;border-radius:2px;margin-right:6px;vertical-align:1px}
.tag.self{color:var(--rel)} .tag.negotiate{color:var(--aut)} .tag.structural{color:var(--comp)} .tag.load{color:var(--watch)}
.item{padding:16px 0;border-top:1px solid var(--line)}
.item:first-of-type{border-top:0}
.item p{margin:6px 0}
table{border-collapse:collapse;width:100%;font-size:13px}
th,td{text-align:right;padding:7px 8px;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums;white-space:nowrap}
th:first-child,td:first-child{text-align:left}
th{font-weight:500;color:var(--muted)}
.scroll{overflow-x:auto}
.tri{width:34px;height:34px;padding:0;border:1px solid var(--line);font:500 15px/1 var(--mono);color:var(--muted)}
.tri[data-v="1"]{background:var(--ok);color:var(--bg);border-color:var(--ok)}
.tri[data-v="-1"]{background:var(--attn);color:var(--bg);border-color:var(--attn)}
.areas{display:grid;grid-template-columns:1fr repeat(3,34px);gap:6px 8px;align-items:center;font-size:13.5px}
.areas b{font:500 11px var(--mono);text-align:center;color:var(--muted)}
.report h3{font:400 19px/1.25 var(--display);margin:20px 0 4px}
.report ul{padding-left:18px;margin:6px 0}
.report p,.report li{max-width:62ch}
.notice{margin:14px 0 0;padding:11px 14px;font-size:13.5px;background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--watch)}
#toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:11px 16px;font-size:14px;border-radius:2px;opacity:0;pointer-events:none;transition:opacity .2s;max-width:90vw;z-index:9}
#toast.on{opacity:1}
.hbar{display:grid;grid-template-columns:minmax(120px,1fr) 2fr 24px;gap:10px;align-items:center;font-size:13px;margin:6px 0}
@media (prefers-reduced-motion: reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
  <header class="mast">
    <p class="eyebrow">Experimental personal monitoring tool</p>
    <h1>The Self-Determination <em>Dashboard</em></h1>
    <p class="sub">Understanding what sustains me, what depletes me, and what needs to change.</p>
  </header>
  <nav class="tabs" aria-label="Sections">
    <a href="#overview">Overview</a><a href="#check-in">Check-in</a><a href="#trends">Trends</a><a href="#actions">Actions</a><a href="#journal">Journal</a><a href="#report">Report</a><a href="#data">Data</a>
  </nav>
  <div id="notice"></div>
  <main id="view"></main>
</div>
<div id="toast" role="status" aria-live="polite"></div>

<script id="core">
/* Pure logic: no DOM. */
var SDD = (function(){
  var DOMAINS = [
    {id:'aut', name:'Autonomy', kind:'need', s:'aut_s', f:'aut_f',
     satQ:'I had meaningful control over my work, my time and my direction.',
     frQ:'I felt pressured into things I did not really want to do.',
     reflect:'What gave me a sense of autonomy this week? What made me feel constrained?',
     factors:{money:'Financial limitations',institution:'Institutional restrictions',workload:'Workload',expectations:'External expectations',social:'Social obligations',schedule:'Unclear schedules',nopower:'Lack of decision-making power',admin:'Administrative burdens',avoidance:'Procrastination or avoidance'}},
    {id:'comp', name:'Competence', kind:'need', s:'comp_s', f:'comp_f',
     satQ:'I felt effective and capable, with room to use and grow my skills.',
     frQ:'I repeatedly felt inadequate, ineffective or incapable.',
     reflect:'When did I feel particularly competent? When did I feel ineffective?',
     factors:{underused:'Underused skills',training:'Insufficient training',feedback:'Lack of feedback',hard:'Difficult responsibilities',repetitive:'Repetitive work',stagnation:'Intellectual stagnation',progress:'No meaningful progress',resources:'Inadequate resources'}},
    {id:'rel', name:'Relatedness', kind:'need', s:'rel_s', f:'rel_f',
     satQ:'I felt connected to people who matter to me.',
     frQ:'I felt excluded, rejected or emotionally disconnected.',
     reflect:'When did I feel connected to other people? What contributed to loneliness?',
     factors:{lonely:'Loneliness',single:'Being single',activities:'Few social activities',moneysocial:'Cost of socialising',transport:'Transport difficulties',conflict:'Interpersonal conflict',support:'Too little emotional support',intellectual:'No intellectual companionship'}},
    {id:'energy', name:'Energy', kind:'state', s:'energy', f:null,
     satQ:'Physical and mental energy, vitality, and readiness to start things.',
     reflect:'What replenished my energy? What drained it?',
     factors:{physical:'Physical tiredness',cognitive:'Cognitive fatigue',motivation:'Hard to start things'}},
    {id:'recovery', name:'Recovery', kind:'state', s:'recovery', f:null,
     satQ:'Sleep, rest on waking, leisure time and detachment from work.',
     reflect:'What interfered with recovery? What helped?',
     factors:{sleep:'Short or poor sleep',unrested:'Waking unrested',noleisure:'No leisure time',detach:'Could not detach from work',accumulated:'Accumulated fatigue'}}
  ];
  var KEYS = ['aut_s','aut_f','comp_s','comp_f','rel_s','rel_f','energy','recovery'];
  var KEYNAMES = {aut_s:'Autonomy satisfaction',aut_f:'Autonomy frustration',comp_s:'Competence satisfaction',comp_f:'Competence frustration',rel_s:'Relatedness satisfaction',rel_f:'Relatedness frustration',energy:'Energy',recovery:'Recovery'};
  var AREAS = {clinical:'Clinical work',research:'Research',teaching:'Teaching and academic development',profrel:'Professional relationships',friends:'Friendships',romantic:'Romantic relationships',family:'Family',personal:'Personal development',leisure:'Leisure and creativity',finances:'Financial circumstances',health:'Physical health and recovery'};
  var WORK_AREAS = ['clinical','research','teaching','profrel'];

  /* t: self = I can do this myself; negotiate = needs someone else's agreement; structural = may not be individually solvable. load: adds to workload. */
  var SUG = {
    aut:{
      money:[{t:'self',text:'Name one income decision that is yours to make this month (a fee, a slot, an invoice to chase) and make it.'},
             {t:'structural',text:'Write down which funding or pay arrangement the pressure comes from and when it is next decided. Plan around that date; a mood boost will not move it.'}],
      institution:[{t:'negotiate',text:'Ask for the rule or restriction in writing, and ask what flexibility exists inside it.'},
                   {t:'self',text:'List what you can decide without anyone\'s permission this week, and decide one of those things.'}],
      workload:[{t:'self',text:'Defer or drop one commitment this week. Choose which one today.'}],
      expectations:[{t:'negotiate',text:'Take one commitment you accepted under pressure and renegotiate its scope, date or format with the person who asked.'},
                    {t:'self',text:'Before the next yes, wait a day and ask whether you would accept the same request from a stranger. That separates the obligation from the relationship.'}],
      social:[{t:'negotiate',text:'Decline or shorten one social obligation this week, and say so early.'}],
      schedule:[{t:'negotiate',text:'Ask for the missing dates in writing and give a date by which you need the answer.'},
                {t:'self',text:'List the decisions you can make now without that information, and make them.'}],
      nopower:[{t:'structural',text:'Note where the decision actually sits. If this recurs for four weeks, treat it as grounds to renegotiate the role, not as a passing mood.'}],
      admin:[{t:'self',text:'Put admin in one fixed block and keep it out of the rest of the week.'}],
      avoidance:[{t:'self',text:'Do the first ten minutes of the avoided task, then decide freely whether to continue.'}],
      _:[{t:'self',text:'Mark this week\'s commitments as chosen or imposed. Protect one chosen block of time.'},
         {t:'negotiate',text:'Pick the most imposed commitment and ask to change one thing about it.'}]
    },
    comp:{
      underused:[{t:'self',text:'Inside work you already have, pick one case to work up as a full medical and psychiatric formulation.'},
                 {t:'negotiate',text:'Ask for a change in case mix: more assessment, medical psychiatry, teaching or consult work.'}],
      training:[{t:'self',text:'Choose one psychotherapy micro-skill and practise it deliberately in a session you already have booked.'},
                {t:'negotiate',text:'Arrange supervision or peer consultation for the cases where you feel least effective.'}],
      feedback:[{t:'negotiate',text:'Ask one supervisor or peer for specific feedback on one piece of work.'}],
      hard:[{t:'negotiate',text:'Name the responsibility that outruns your current training and ask for support or shared cover on it.'}],
      repetitive:[{t:'self',text:'Change one thing in the repetitive work: teach it, audit it, or write up one interesting instance.'}],
      stagnation:[{t:'self',load:true,text:'Give yourself two short, deadline-free sessions on something intellectually alive: a course, a paper, a reading project.'}],
      progress:[{t:'self',text:'Finish one small thing end to end this week and write down that you did.'}],
      resources:[{t:'structural',text:'Record which missing resource is limiting your work and who controls it. This is not a competence problem.'}],
      _:[{t:'self',text:'Recall the last piece of work that felt like mastery, and schedule one hour of that kind of work.'},
         {t:'negotiate',text:'Ask for feedback on something you did well, so perceived and actual competence can be compared.'}]
    },
    rel:{
      lonely:[{t:'self',text:'Message one existing friend today and fix a time to talk this week.'}],
      single:[{t:'self',text:'Being single is context, not a deficit. Name which kind of connection you actually missed this week before acting on it.'}],
      activities:[{t:'self',text:'Put one low-cost shared activity in the calendar: a walk, a meal at home, a call.'}],
      moneysocial:[{t:'self',text:'Choose contact that costs nothing: a long call, a walk, hosting at home.'}],
      transport:[{t:'self',text:'Pick contact that needs no travel this week, or invite someone to come to you.'}],
      conflict:[{t:'negotiate',text:'Have the conversation you are postponing, or decide deliberately to let the matter go.'}],
      support:[{t:'self',text:'Tell one trusted person plainly what this period has been like.'}],
      intellectual:[{t:'self',load:true,text:'Join or start one recurring exchange of ideas: a journal club, a reading group, an online community.'}],
      _:[{t:'self',text:'Reconnect with one person you have not spoken to in a month.'}]
    },
    energy:{
      _:[{t:'self',text:'Put demanding work in your best hours and leave the rest of the day lighter.'},
         {t:'self',text:'Notice which activity this week cost more energy than it should have, and shorten or move it.'}]
    },
    recovery:{
      sleep:[{t:'self',text:'Log your actual sleep and wake times for seven days before changing anything.'}],
      detach:[{t:'self',text:'Set an end-of-work cue so that work stops occupying your attention in the evening.'}],
      noleisure:[{t:'self',text:'Protect one work-free block this week and decide in advance what it is for.'}],
      _:[{t:'self',text:'Before adding anything new, remove or defer one commitment this week.'},
         {t:'self',text:'Protect one work-free block this week and decide in advance what it is for.'},
         {t:'structural',text:'If recovery stays low for three weeks despite this, the load itself needs renegotiating.'}]
    }
  };

  function band(v){ if(v==null) return 'not assessed'; return v<=2?'very low':v<=4?'low':v<=6?'moderate':v<=8?'high':'very high'; }
  function mean(a){ return a.length? a.reduce(function(x,y){return x+y;},0)/a.length : null; }
  function sortC(list){ return list.slice().sort(function(a,b){return a.date<b.date?-1:a.date>b.date?1:0;}); }
  function val(c,key){ return (c && c.scores && c.scores[key]!=null) ? c.scores[key] : null; }
  function series(cs,key){ return cs.map(function(c){return val(c,key);}); }
  function dom(id){ for(var i=0;i<DOMAINS.length;i++) if(DOMAINS[i].id===id) return DOMAINS[i]; return null; }
  function label(d){ return d.kind==='need' ? d.name+' satisfaction' : d.name; }

  function baseline(cs,key,profile){
    profile = profile||{};
    var m = profile.manual && profile.manual[key];
    if(m!=null && m!=='' && !isNaN(+m)) return {value:+m, source:'set by you'};
    var w = +profile.baselineWeeks || 6;
    if(cs.length < w) return null;
    var vals = series(cs,key).slice(0,w).filter(function(v){return v!=null;});
    if(vals.length < 3) return null;
    return {value:mean(vals), source:'mean of your first '+w+' check-ins'};
  }

  function analyse(checkins, interventions, profile){
    var cs = sortC(checkins||[]), n = cs.length, out = {n:n, domains:{}, level:'none', affected:[]};
    if(!n) return out;
    interventions = interventions||[]; profile = profile||{};
    var w = +profile.baselineWeeks || 6;
    DOMAINS.forEach(function(d){
      var f = [], s = series(cs,d.s), cur = s[n-1], prev = n>1 ? s[n-2] : null, L = label(d);
      if(cur!=null){
        var t3 = s.slice(-3), t4 = s.slice(-4);
        var pl = t3.length===3 && t3.every(function(v){return v!=null && v<=4;});
        if(pl) f.push({type:'persistent-low',weight:2,text:L+' has been low (4 or below) for three check-ins in a row.'});
        else if(cur<=4) f.push({type:'isolated-low',weight:1,text:L+' is '+band(cur)+' this week ('+cur+'/10). One low score is not yet a trend.'});
        if(prev!=null && cur-prev<=-3) f.push({type:'rapid-decline',weight:2,text:L+' fell '+(prev-cur)+' points since the last check-in.'});
        if(t4.length===4 && t4.every(function(v){return v!=null;}) && t4[1]<t4[0] && t4[2]<t4[1] && t4[3]<t4[2]) f.push({type:'sustained-decline',weight:2,text:L+' has fallen at each of the last three check-ins.'});
        var b = baseline(cs,d.s,profile);
        if(b && n>w && prev!=null && cur<=b.value-2 && prev<=b.value-2) f.push({type:'below-baseline',weight:2,text:L+' has been 2 or more points below your baseline ('+b.value.toFixed(1)+') for two check-ins.'});
      }
      if(d.f){
        var fr = series(cs,d.f), fc = fr[n-1], fp = n>1 ? fr[n-2] : null;
        if(fc!=null){
          var f3 = fr.slice(-3), f4 = fr.slice(-4);
          if(f3.length===3 && f3.every(function(v){return v!=null && v>=6;})) f.push({type:'persistent-frustration',weight:2,text:d.name+' frustration has been high (6 or above) for three check-ins in a row.'});
          else if(fc>=6) f.push({type:'high-frustration',weight:1,text:d.name+' frustration is high this week ('+fc+'/10).'});
          if(fp!=null && fc-fp>=3) f.push({type:'rising-frustration',weight:2,text:d.name+' frustration rose '+(fc-fp)+' points since the last check-in.'});
          else if(f4.length===4 && f4.every(function(v){return v!=null;}) && f4[1]>f4[0] && f4[2]>f4[1] && f4[3]>f4[2]) f.push({type:'rising-frustration',weight:2,text:d.name+' frustration has risen at each of the last three check-ins.'});
        }
      }
