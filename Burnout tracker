  }

  var LEVELS = {
    none:{name:'No check-ins yet',pips:0,text:'Record a check-in to begin.'},
    stable:{name:'Stable',pips:0,text:'No meaningful deterioration in any dimension.'},
    watch:{name:'Watch',pips:1,text:'One dimension shows a concerning score or decline.'},
    attention:{name:'Attention needed',pips:2,text:'Persistent deterioration, or more than one dimension affected.'},
