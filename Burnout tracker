    (checkins||[]).forEach(function(c){ var ar=c.areas||{}; Object.keys(ar).forEach(function(a){ if(!m[a]) return; ['aut','comp','rel'].forEach(function(nk){ var v=ar[a][nk]; if(v===1) m[a][nk][0]++; else if(v===-1) m[a][nk][1]++; }); }); });
