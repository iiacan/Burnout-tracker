  else if(act==='report'||act==='themes'){ if(!S.sample||S.busy) return; var isR=act==='report', withJ=isR && $('#rp-journal') && $('#rp-journal').checked, outSel=isR?'#report-out':'#themes-out';
    var input = isR ? REPORT_RULES+'\n\nABOUT THE PERSON (their own words):\n'+(S.profile.context||'(none provided)')+'\n\nDATA (JSON):\n'+JSON.stringify(reportPayload(withJ))
      : 'Below are private journal entries from one person, newest first. Identify recurring themes across them. Write two sections, each starting with "## ": "Observations" (only what the entries literally say, with rough counts, e.g. "institutional pressure is mentioned in 3 entries") and "Tentative interpretations" (clearly hedged, at most four, each tied to the observations it rests on). Never diagnose or infer a psychiatric condition. No advice, no motivational language. Use "- " bullets. Under 300 words.\n\nENTRIES (JSON):\n'+JSON.stringify(S.journal.slice().sort(function(a,b2){return (b2.created||'').localeCompare(a.created||'');}).slice(0,30).map(function(j){return {date:(j.created||'').slice(0,10),prompt:j.prompt||null,text:j.text};}));
    S.busy=act; b.disabled=true; b.textContent=isR?'Writing…':'Reading…';
    try{ var res=await S.sample(input,{cache:false,onText:function(x){ var o=$(outSel); if(o) o.innerHTML=md(x.text); }});
      var text=(res&&res.text)||''; if(text) await guard(function(){return Store.put('reports',isR?latest().date:'themes',{text:text,kind:isR?'weekly':'themes',created:new Date().toISOString()});});
    }catch(err){ toast(err&&err.code==='rate_limited'?'Too many requests. Try again in a minute.':err&&err.code==='not_granted'?'AI analysis was not allowed for this page.':'The report could not be written. Try again.'); }
    S.busy=null; render(); }
  else if(act==='exp-csv') exportFile('self-determination-checkins.csv',SDD.csv(S.checkins));
  else if(act==='exp-json') exportFile('self-determination-data.json',JSON.stringify({exported:new Date().toISOString(),profile:S.profile,checkins:cs(),interventions:S.interventions,journal:S.journal,reports:S.reports},null,2));
  else if(act==='exp-pdf'){ if(!latest()){ toast('Nothing to export yet.'); return; } var buf=null; try{ buf=makePdf(); }catch(err2){} if(buf) exportFile('self-determination-report-'+latest().date+'.pdf',buf); else exportFile('self-determination-report-'+latest().date+'.md',plainReport()); }
  else if(act==='save-profile'){ S.profile.context=$('#pf-context').value; S.profile.baselineWeeks=Math.max(3,Math.min(26,+$('#pf-weeks').value||6)); S.profile.manual={}; D.forEach(function(d){ var v=$('#bl-'+d.s).value; if(v!=='') S.profile.manual[d.s]=+v; }); await guard(function(){return Store.putProfile();},'Saved'); render(); }
  else if(act==='wipe'){ S.confirmDelete='all'; render(); }
  else if(act==='wipe-no'){ S.confirmDelete=false; render(); }
  else if(act==='wipe-yes'){ S.confirmDelete=false; await guard(function(){return Store.wipe();},'All data deleted'); S.draft=null; render(); }
});

async function boot(){
  route(); render();
  await Store.init(); S.ready=true; render();
  try{ if(navigator.storage && navigator.storage.persist) navigator.storage.persist(); }catch(e){}
  if(false){
    window.claude.use('sample').then(function(x){ S.sample=x||null; if(x && S.view==='report') render(); }).catch(function(){});
    window.claude.use('downloads').then(function(x){ S.downloads=x||null; if(x && S.view==='data') render(); }).catch(function(){});
  }
}
boot();
})();
</script>
